{
  // Host 聚合面：typert generator 以此为 workspace root（tsdown 插件经
  // workspaceRoot 向上查找 tsconfig.host.json 定位仓库根），并通过 project
  // references 发现贡献包。sandore 仅 workflow 包有 Host Remote 面。
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "files": [],
  "references": [
    { "path": "./packages/sandore/workflow" }
  ]
}
